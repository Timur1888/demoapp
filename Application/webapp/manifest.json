{
  "_version": "1.81.0",
  "sap.app": {
    "id": "demo.app.demoapp",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.3"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.20.2",
      "toolsId": "f9766f13-8736-4ba0-ad4f-41a6b564371a"
    },
    "crossNavigation": {
      "inbounds": {
        "demo-app-cdm-demoapp-inbound": {
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          },
          "semanticObject": "BillingApp",
          "action": "display",
          "title": "Billing",
          "subTitle": "",
          "icon": ""
        }
      }
    }
  },
  "sap.fiori": {
    "archeType": "transactional"
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "ach": "demo.app.demoapp",
    "dependencies": {
      "minUI5Version": "1.144.1",
      "libs": {
        "sap.ui.comp": {},
        "sap.ui.fl": {},
        "sap.ui.mdc": {},
        "sap.m": {},
        "sap.f": {},
        "sap.ui.core": {},
        "sap.ui.unified": {},
        "sap.ui.layout": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "config": {
      "fullWidth": true
    },
    "models": {
      "backend": {
        "type": "sap.ui.model.json.JSONModel"
      },
      "auth": {
        "type": "sap.ui.model.json.JSONModel"
      },
      "filterModel": {
        "type": "sap.ui.model.json.JSONModel"
      },
      "billingConfig": {
        "type": "sap.ui.model.json.JSONModel"
      },
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "demo.app.demoapp.i18n.i18n",
          "supportedLocales": [
            "de",
            "en"
          ],
          "fallbackLocale": "en"
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlAggregation": "beginColumnPages",
        "controlId": "layout",
        "clearControlAggregation": true,
        "transition": "slide",
        "type": "View",
        "viewType": "XML",
        "path": "demo.app.demoapp.view",
        "async": true,
        "viewPath": "demo.app.demoapp.view"
      },
      "routes": [
        {
          "name": "RouteView1",
          "pattern": "",
          "target": [
            "TargetView1"
          ]
        },
        {
          "name": "DetailsRoute",
          "pattern": "Details/{invoiceId}",
          "target": [
            "Details"
          ]
        }
      ],
      "targets": {
        "TargetView1": {
          "id": "View1",
          "name": "View1",
          "viewLevel": "1",
          "controlAggregation": "beginColumnPages"
        },
        "Details": {
          "id": "Details",
          "name": "Details",
          "viewLevel": 2,
          "controlAggregation": "midColumnPages"
        }
      }
    },
    "rootView": {
      "viewName": "demo.app.demoapp.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  },
  "sap.cloud": {
    "public": true,
    "service": "demo.app.demoapp"
  }
}