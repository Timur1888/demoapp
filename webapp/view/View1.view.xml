<mvc:View controllerName="demo.app.demoapp.controller.View1"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.f"
    xmlns:fb="sap.ui.comp.filterbar"
    xmlns:svm="sap.ui.comp.smartvariants">


    <f:DynamicPage id="dpBilling" headerExpanded="true" toggleHeaderOnTitleClick="true">
        <f:title>
            <f:DynamicPageTitle id="dptTitle">

                <f:heading>
                    <svm:SmartVariantManagement id="svm" showExecuteOnSelection="true" persistencyKey="BillingFilterBarVariant"/>
                </f:heading>
                <f:expandedContent>
                    <Label id="expandedLabel" text="{i18n>variantsFilters}" />
                </f:expandedContent>
                <f:snappedContent>
                    <Label id="snappedLabel" text="{i18n>variantsFilters}" />
                </f:snappedContent>

                <f:actions>

                    <Button id="btnSettings" icon="sap-icon://action-settings" press=".onSettings" />
                </f:actions>

            </f:DynamicPageTitle>
        </f:title>

        <!-- ====== COLLAPSIBLE / PINNABLE HEADER ====== -->
        <f:header>
            <f:DynamicPageHeader id="dphHeader" pinnable="true">
                <f:content>

                    <Button id="clFilt" text="{i18n>clearFilters}" type="Transparent" press=".onClearFilters"/>

                    <!-- Hier ist der Bereich wie im Screenshot (Filter + Search) -->
                    <fb:FilterBar id="filterbar" persistencyKey="myPersKey" useToolbar="false" search=".onSearch" filterChange=".onFilterChange" afterVariantLoad=".onAfterVariantLoad">
                        <fb:filterGroupItems>

                            <!-- Globale Suche  -->
                            <fb:FilterGroupItem id="fgiQuickSearch" groupName="Group1" name="Search" label="{i18n>Search}" visibleInFilterBar="true">
                                <fb:control>
                                    <SearchField id="sfSearch" width="18rem" placeholder="{i18n>Search}" value="{filterModel>/globalSearch}" search=".onSearch" />
                                </fb:control>
                            </fb:FilterGroupItem>

                            <!-- ====== Status ====== -->
                            <fb:FilterGroupItem id="fgiStatus" name="State" label="{i18n>State}" groupName="Group1" visibleInFilterBar="true">
                                <fb:control>
                                    <MultiComboBox id="mcbStatus" name="State" selectedKeys="{filterModel>/selectedStates}" selectionFinish=".onSearch" items="{
                                path: 'filterModel>/StatusList',
                                templateShareable: false
                            }">
                                        <core:Item id = "itemStatus" key="{filterModel>key}" text="{path: 'filterModel>text',
                                                                formatter: '.formatter.formatAbbreviations'}" />
                                    </MultiComboBox>
                                </fb:control>
                            </fb:FilterGroupItem>
                            <!-- ====== Recipient name ====== -->
                            <fb:FilterGroupItem id="fgiRecipientName" name="RecipientName" label="{i18n>RecName}" groupName="Group1" visibleInFilterBar="true">
                                <fb:control>
                                    <SearchField id="sfRecipientName" width="50%" placeholder="{i18n>RecName}" value="{filterModel>/recipientName}" search=".onSearch">
                                    </SearchField>
                                </fb:control>
                            </fb:FilterGroupItem>

                            <!-- ====== Netto Betrag ====== -->
                            <fb:FilterGroupItem id="fgiNettoValue" name="NettoValue" label="{i18n>Netto}" groupName="Group1" visibleInFilterBar="true">
                                <fb:control>
                                    <SearchField id="sfNettoValue" width="50%" placeholder="{i18n>FromTo}" value="{filterModel>/nettoValue}" search=".onSearch" />
                                </fb:control>
                            </fb:FilterGroupItem>

                            <!-- ====== InvoiceNo ====== -->
                            <fb:FilterGroupItem id="fgiInvoiceNo" name="InvoiceNo" label="{i18n>InvNo}" groupName="Group1" visibleInFilterBar="true">
                                <fb:control>
                                    <SearchField id="sfInvNo" width="50%" placeholder="{i18n>InvNo}" value="{filterModel>/invoiceNo}" search=".onSearch"/>
                                </fb:control>
                            </fb:FilterGroupItem>

                            <!-- ====== Sales organisation ====== -->
                            <fb:FilterGroupItem id="fgiSalesOrg" name="SalesOrganisation" label="{i18n>SalesOrg}" groupName="Group1" visibleInFilterBar="true">
                                <fb:control>
                                    <MultiComboBox id="mcbSalesOrg" name="SalesOrganisation" selectedKeys="{filterModel>/salesOrganisation}" selectionFinish=".onSearch" items="{filterModel>/SalesOrganisationList}">
                                        <core:Item id = "itemSalesOrg" key="{filterModel>key}" text="{filterModel>text}" />
                                    </MultiComboBox>
                                </fb:control>
                            </fb:FilterGroupItem>

                            <!-- ====== Invoice Type ====== -->
                            <fb:FilterGroupItem id="fgiInvType" name="InvoiceType" label="{i18n>Type}" groupName="Group1" visibleInFilterBar="true">
                                <fb:control>
                                    <MultiComboBox id="mcbInvType" name="InvoiceType" selectedKeys="{filterModel>/invoiceType}" selectionFinish=".onSearch" items="{filterModel>/InvoiceTypeList}">
                                        <core:Item id = "itemInvType" key="{filterModel>key}" text="{filterModel>text}" />
                                    </MultiComboBox>
                                </fb:control>
                            </fb:FilterGroupItem>

                            <!-- ====== Sub Type ====== -->
                            <fb:FilterGroupItem id="fgiSubType" name="SubType" label="{i18n>SubType}" groupName="Group1" visibleInFilterBar="true">
                                <fb:control>
                                    <SearchField id="sfSubType" width="50%" value="{filterModel>/subType}" placeholder="{i18n>SubType}" search=".onSearch">
                                    </SearchField>
                                </fb:control>
                            </fb:FilterGroupItem>

                            <!-- ====== Factura Datee ====== -->
                            <fb:FilterGroupItem id="fgiFacturaDate" name="FacturaDate" label="{i18n>FacDate}" groupName="Group1" visibleInFilterBar="true">
                                <fb:control>
                                    <DateRangeSelection id="drsFacturaDate" displayFormat="{i18n>ddMMyyyy}" showCurrentDateButton="true" showFooter="true" valueFormat="yyyy-MM-dd" dateValue="{filterModel>/factDateFrom}" secondDateValue="{filterModel>/factDateTo}" change=".onFacturaDateChange" parseError=".onFacturaDateParseError" class="facturaDateSmallText"/>
                                </fb:control>
                            </fb:FilterGroupItem>

                        </fb:filterGroupItems>
                    </fb:FilterBar>
                </f:content>
            </f:DynamicPageHeader>
        </f:header>

        <!-- ====== CONTENT ====== -->
        <f:content>
            <VBox id="billingTableHost" class="billingTableHost" fitContainer="true">



                <ScrollContainer id="scBillingTable" width="100%" height="100%" horizontal="true" vertical="true" focusable="true">

                    <VBox id="billingTableCanvas" class="billingTableCanvas">

                        <Table id="tblBilling" width="auto" inset="false" alternateRowColors="true" noDataText="{i18n>SetFilters}" sticky="ColumnHeaders" mode="MultiSelect" items="{backend>/value}" itemPress=".onInvoicePress" selectionChange=".onSelectionChange">

                            <infoToolbar>
                                <OverflowToolbar id="vsdFilterBar" visible="false">
                                    <Text id="vsdFilterLabel" />
                                </OverflowToolbar>
                            </infoToolbar>

                            <columns>
                                <!-- ====== Status ====== -->
                                <Column id="colStatus"  headerMenu="columnHeaderMenu" hAlign="Center" width="55px">
                                    <customData>
                                        <core:CustomData key="sortKey" value="State" writeToDom="false"/>
                                    </customData>
                                    <Text id="txtColStatus" text="{i18n>State}"/>
                                </Column>
                                <!-- ====== Delivery Mode ====== -->
                                <Column id="colDeliveryMode"  headerMenu="columnHeaderMenu" hAlign="Center" width="105px">
                                    <customData>
                                        <core:CustomData key="sortKey" value="Process/DeliveryPlan/ExecutionMode" writeToDom="false"/>
                                    </customData>
                                    <Text id="txtColEliveryMode" text="{i18n>DelMode}"/>
                                </Column>
                                <!-- ====== Recipient Name ====== -->
                                <Column id="colRecipientName"  headerMenu="columnHeaderMenu" hAlign="Center" width="115px">
                                    <customData>
                                        <core:CustomData key="sortKey" value="MetaData/Object/Data/Basics/Recipient/Name" writeToDom="false"/>
                                    </customData>
                                    <Text id="txtColRecipientName" text="{i18n>RecName}"/>
                                </Column>
                                <!-- ====== E-Mail ====== -->
                                <Column id="colRecipientEmail"  headerMenu="columnHeaderMenu" hAlign="Center" width="115px">
                                    <customData>
                                        <core:CustomData key="sortKey" value="MetaData/Object/Data/Basics/Recipient/Email/0/Address" writeToDom="false"/>
                                    </customData>
                                    <Text id="txtColRecipientEmail" text="{i18n>RecEmail}"/>
                                </Column>
                                <!-- ====== Invoice No ====== -->
                                <Column id="colInvoiceNo" headerMenu="columnHeaderMenu" hAlign="Center" width="90px">
                                    <customData>
                                        <core:CustomData key="sortKey" value="MetaData/Object/Data/Basics/Number/Value" writeToDom="false"/>
                                    </customData>
                                    <Text id="txtColInvoiceNo" text="{i18n>InvNo}"/>
                                </Column>
                                <!-- ====== Invoice Type ====== -->
                                <Column id="colInvoiceType" hAlign="Center" headerMenu="columnHeaderMenu" width="95px">
                                    <customData>
                                        <core:CustomData key="sortKey" value="MetaData/Object/Data/Type" writeToDom="false"/>
                                    </customData>
                                    <Text id="txtColInvoiceType" text="{i18n>Type}"/>
                                </Column>
                                <!-- ====== Sub Type ====== -->
                                <Column id="colSubType" hAlign="Center" headerMenu="columnHeaderMenu" width="90px">
                                    <customData>
                                        <core:CustomData key="sortKey" value="MetaData/Object/Data/SubType" writeToDom="false"/>
                                    </customData>
                                    <Text id="txtColSubType" text="{i18n>SubType}"/>
                                </Column>
                                <!-- ====== Netto Value ====== -->
                                <Column id="colNettoValue" hAlign="Center" width="115px" headerMenu="columnHeaderMenu">
                                    <customData>
                                        <core:CustomData key="sortKey" value="MetaData/Object/Data/Amounts/Net/Value" writeToDom="false"/>
                                    </customData>
                                    <Text id="txtColNettoValue" text="{i18n>Netto}"/>
                                </Column>
                                <!-- ====== Brutto Value ====== -->
                                <Column id="colBruttoValue" hAlign="Center" width="115px" headerMenu="columnHeaderMenu">
                                    <customData>
                                        <core:CustomData key="sortKey" value="MetaData/Object/Data/Amounts/Gross/Value" writeToDom="false"/>
                                    </customData>
                                    <Text id="txtColBruttoValue" text="{i18n>Brutto}"/>
                                </Column>
                                <!-- ====== CCY ====== -->
                                <Column id="colCcy" headerMenu="columnHeaderMenu" hAlign="Center" width="70px">
                                    <customData>
                                        <core:CustomData key="sortKey" value="MetaData/Object/Data/Amounts/Currency/Value" writeToDom="false"/>
                                    </customData>
                                    <Text id="txtColCcy" text="{i18n>CCY}"/>
                                </Column>
                                <!-- ====== Origin ====== -->
                                <Column id="colOrigin" headerMenu="columnHeaderMenu" width="100px" hAlign="Center">
                                    <customData>
                                        <core:CustomData key="sortKey" value="MetaData/OriginSystem" writeToDom="false"/>
                                    </customData>
                                    <Text id="txtOrigin" text="{i18n>Origin}"/>
                                </Column>
                                <!-- ====== Sales Org ====== -->
                                <Column id="colSalesOrg" headerMenu="columnHeaderMenu" width="126px" hAlign="Center">
                                    <customData>
                                        <core:CustomData key="sortKey" value="MetaData/Object/Data/BusinessPartners/0/SalesOrganisation/Value" writeToDom="false"/>
                                    </customData>
                                    <Text id="txtColSalesOrg" text="{i18n>SalesOrg}"/>
                                </Column>
                                <!-- ====== Factura Date ====== -->
                                <Column id="colFacturaDate" headerMenu="columnHeaderMenu" width="110px" hAlign="Center">
                                    <customData>
                                        <core:CustomData key="sortKey" value="MetaData/Object/Data/Basics/Date/Value/$date" writeToDom="false"/>
                                    </customData>
                                    <Text id="txtColFacturaDate" text="{i18n>FacDate}"/>
                                </Column>
                                <!-- ====== Creation Datee ====== -->
                                <Column id="colCreationDate" headerMenu="columnHeaderMenu"  width="108px" hAlign="Center">
                                    <customData>
                                        <core:CustomData key="sortKey" value="History/Created/Date/$date" writeToDom="false"/>
                                    </customData>
                                    <Text id="txtColCreationDate" text="{i18n>CreateDate}"/>
                                </Column>
                                <!-- ====== Dispatch Datee ====== -->
                                <Column id="colDispatchDate" headerMenu="columnHeaderMenu" width="105px" hAlign="Center">
                                    <customData>
                                        <core:CustomData key="sortKey" value="MetaData/Object/Data/Basics/SendDate/$date" writeToDom="false"/>
                                    </customData>
                                    <Text id="txtColDispatchDate" text="{i18n>DispDate}"/>
                                </Column>
                                <!-- ====== Transfer Format ====== -->
                                <Column id="colTransferFormat" headerMenu="columnHeaderMenu" width="125px" hAlign="Center">
                                    <customData>
                                        <core:CustomData key="sortKey" value="MetaData/Object/Data/Basics/TransferFormat" writeToDom="false"/>
                                    </customData>
                                    <Text id="txtColTransferFormat" text="{i18n>TransForm}"/>
                                </Column>
                                <!-- ====== Delivery Method ====== -->
                                <Column id="colDeliveryMethod" headerMenu="columnHeaderMenu" width="150px" hAlign="Center">
                                    <customData>
                                        <core:CustomData key="sortKey" value="MetaData/Object/Data/Basics/DeliveryMethod" writeToDom="false"/>
                                    </customData>
                                    <Text id="txtColDeliveryMethod" text="{i18n>DelMeth}"/>
                                </Column>
                                <!-- ====== Delivery ID ====== -->
                                <Column id="colDeliveryId" headerMenu="columnHeaderMenu" width="85px" hAlign="Center">
                                    <customData>
                                        <core:CustomData key="sortKey" value="MetaData/Object/Data/BusinessPartners/1/LeitwegId/Value" writeToDom="false"/>
                                    </customData>
                                    <Text id="txtColDeliveryId" text="{i18n>DelID}"/>
                                </Column>
                                <!-- ====== PDF ====== -->
                                <Column id="colPdf" headerMenu="columnHeaderMenu" width="50px" hAlign="Center">
                                    <customData>
                                        <core:CustomData key="sortKey" value="MetaData/Object/Data/Basics/TransferFormat" writeToDom="false"/>
                                    </customData>
                                    <Text id="txtColPdf" text="{i18n>PDF}"/>
                                </Column>
                            </columns>

                            <items>
                                <ColumnListItem id="cliBilling" type="Active">
                                    <cells>
                                        <ObjectStatus id="osState" text="" icon="{
                                        path: 'backend>State',
                                        formatter: '.formatter.formatStatusIcon'
                                    }" state="{
                                        path: 'backend>State',
                                        formatter: '.formatter.formatStatusState'
                                    }" />

                                        <ObjectStatus id="txtDeliveryMode" text="" icon="{
                                        path: 'backend>Process/DeliveryPlan/ExecutionMode',
                                        formatter: '.formatter.formatDeliveryModeIcon'
                                    }" state="{
                                        path: 'backend>Process/DeliveryPlan/ExecutionMode',
                                        formatter: '.formatter.formatDeliveryModeState'
                                    }" />

                                        <Text id="txtRecipientName" text="{backend>MetaData/Object/Data/Basics/Recipient/Name}" />
                                        <Text id="txtRecipientEmail" text="{backend>MetaData/Object/Data/Basics/Recipient/Email/0/Address}" />
                                        <Text id="txtInvoiceNo" text="{backend>MetaData/Object/Data/Basics/Number/Value}" />

                                        <Text id="txtInvoiceType" text="{
                                    path: 'backend>MetaData/Object/Data/Type',
                                    formatter: '.formatter.formatAbbreviations'
                                }" />

                                        <Text id="txtSubType" text="{backend>MetaData/Object/Data/SubType}" />

                                        <ObjectNumber id="onNetto" number="{
                                        path: 'backend>MetaData/Object/Data/Amounts/Net/Value',
                                        formatter: '.formatter.formatCurrencyValue'
                                    }" />

                                        <ObjectNumber id="onBrutto" number="{
                                        path: 'backend>MetaData/Object/Data/Amounts/Gross/Value',
                                        formatter: '.formatter.formatCurrencyValue'
                                    }" />

                                        <Text id="txtCcyCell" text="{
                                    path: 'backend>MetaData/Object/Data/Amounts/Currency/Value',
                                    formatter: '.formatter.formatAbbreviations'
                                }" />

                                        <Text id="txtOriginCell" text="{backend>MetaData/OriginSystem}" />
                                        <Text id="txtSalesOrgCell" text="{backend>MetaData/Object/Data/BusinessPartners/0/SalesOrganisation/Value}" />

                                        <Text id="txtFacturaDateCell" text="{
                                    path: 'backend>MetaData/Object/Data/Basics/Date/Value/$date',
                                    formatter: '.formatter.formatDate'
                                }" />

                                        <Text id="txtCreationDateCell" text="{
                                    path: 'backend>History/Created/Date/$date',
                                    formatter: '.formatter.formatDate'
                                }" />

                                        <Text id="txtDispatchDateCell" text="{
                                    path: 'backend>MetaData/Object/Data/Basics/SendDate/$date',
                                    formatter: '.formatter.formatDate'
                                }" />

                                        <Text id="txtTransferFormatCell" text="{
                                        path: 'backend>MetaData/Object/Data/Basics/TransferFormat',
                                        formatter: '.formatter.formatAbbreviations'
                                    }" />

                                        <ObjectStatus id = "objStatus" text="{path:'backend>MetaData/Object/Data/Basics/DeliveryMethod', formatter:'.formatter.formatAbbreviations'}" icon="{path:'backend>MetaData/Object/Data/Basics/DeliveryMethod', formatter:'.formatter.formatDeliveryMethodIcon'}" />

                                        <Text id="txtDeliveryIdCell" text="{backend>MetaData/Object/Data/BusinessPartners/1/LeitwegId/Value}" />

                                        <Text id="txtPdfCell" text="{
                                    path: 'backend>MetaData/Object/Data/Basics/TransferFormat',
                                    formatter: '.formatter.formatPdf'
                                }" />
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>

                    </VBox>
                </ScrollContainer>
            </VBox>
        </f:content>
    </f:DynamicPage>

</mvc:View>
