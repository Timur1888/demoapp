<?xml version="1.0" encoding="UTF-8"?>
<mvc:View xmlns:mvc="sap.ui.core.mvc"
   xmlns="sap.m"
   xmlns:core="sap.ui.core"
   xmlns:unified="sap.ui.unified"
   xmlns:upload="sap.m.upload" controllerName="demo.app.demoapp.controller.Details">
   <Page id = "detailsPage" title="Invoice {backend>MetaData/Object/Data/Basics/Number/Value}" showFooter="true">
      <!-- X-Schließen-Button rechts oben -->
      <headerContent>
         <Button id="btnClose" icon="sap-icon://decline" type="Transparent" tooltip="Close" press=".onClose" class="detailCloseBtn" />
      </headerContent>
      <content>
         <!-- Tabs: Overview / History -->
         <IconTabBar id="itbDetails" expanded="true" upperCase="false" selectedKey="overview" select=".onIconTabSelect" stretchContentHeight="true" backgroundDesign="Transparent" applyContentPadding="false">
            <items>
               <!-- ================== OVERVIEW TAB ================== -->
               <IconTabFilter id="overviewFilt" key="overview" text="Overview">
                  <ScrollContainer id="scHistory" height="100%" width="100%" horizontal="false" vertical="true">
                     <!-- ==========================================
                     PDF direkt im Panel + Klick öffnet Popup
                     ========================================== -->
                     <VBox id="overviewVbox" class="sapUiSmallMargin">
                        <Title id="overviewTitle" text="Invoice Files" level="H3" class="sapUiTinyMarginBottom"/>
                        <Carousel id="blobCarousel" class="sapUiContentPadding pdfCarousel" loop="false" pageChanged=".onBlobPageChanged" pages="{backend>/CurrentInvoice/BlobItems}">
                           <pages>
                              <VBox id="overviewVbox2" width="100%" class="pdfPageScroll">

                                 <!-- Preview vorhanden (PDF-Preview ODER Bild-Link) -->
                                 <Image id="overviewPreview" src="{backend>previewLink}" alt="{backend>fileName}" width="100%" decorative="false" densityAware="false" press=".onFilePress" visible="{= !!${backend>previewLink} }" />

                                 <!-- Keine Preview -> Placeholder -->
                                 <VBox id="overviewNoPreview" width="100%" class="pdfPageScroll" alignItems="Center" justifyContent="Center" visible="{= !${backend>previewLink} }">
                                    <core:Icon id="overviewNPIcon" src="{backend>icon}" size="4rem" />
                                    <Text id="overviewNPText" text="{backend>fileName}" class="sapUiSmallMarginTop"/>
                                    <Link id="overviewNPLink" text="{backend>openText}" press=".onFilePress" class="sapUiSmallMarginTop"/>
                                 </VBox>

                              </VBox>
                           </pages>
                        </Carousel>
                     </VBox>
                     <VBox id="overviewVBox3" width="100%" class="sapUiSmallMargin">
                        <!-- Invoice File -->
                        <VBox id="overviewVBox4" class="sapUiSmallMarginTop" width="97%">
                           <Title id="titleUploadInvoice" text="{i18n>UploadInv}" level="H4" />
                           <upload:UploadSet id="uploadSetInvoice" instantUpload="false" uploadEnabled="true" multiple="false" showIcons="true" terminationEnabled="false" fileTypes="pdf,png,jpg,jpeg,docx,doc,xlsx,xls" items="{backend&gt;/CurrentInvoice/InvoiceBlobs}" afterItemAdded=".onInvoiceItemAdded" beforeUploadStarts=".onInvoiceBeforeUploadStarts" uploadCompleted=".onInvoiceUploadCompleted" afterItemRemoved=".onAfterInvoiceItemRemoved">
                              <!-- Wie ein List-Template: -->
                              <upload:items>
                                 <upload:UploadSetItem id="uploadSetItemInvoice" fileName="{backend&gt;FileName}" mediaType="{backend&gt;MimeType}" url="{backend&gt;DownloadUrl}" visibleEdit="false" visibleRemove="true" />
                              </upload:items>
                           </upload:UploadSet>
                        </VBox>
                        <!-- Attachments -->
                        <VBox id="attachmentsVBox" class="sapUiSmallMarginTop" width="97%">
                           <Title id="titleUploadAttachments" text="{i18n>UploadAtt}" level="H4" />
                           <upload:UploadSet id="uploadSetAttachments" instantUpload="false" uploadEnabled="true" multiple="true" showIcons="true" terminationEnabled="false" fileTypes="pdf,png,jpg,jpeg,docx,doc,xlsx,xls" items="{backend&gt;/CurrentInvoice/AttachmentBlobs}" afterItemAdded=".onAttachmentItemAdded" beforeUploadStarts=".onAttachmentBeforeUploadStarts" uploadCompleted=".onAttachmentUploadCompleted" afterItemRemoved=".onAfterAttachmentItemRemoved">
                              <upload:items>
                                 <upload:UploadSetItem id="uploadSetItemAttachment" fileName="{backend&gt;FileName}" mediaType="{backend&gt;MimeType}" url="{backend&gt;DownloadUrl}" visibleEdit="false" visibleRemove="true" />
                              </upload:items>
                           </upload:UploadSet>
                        </VBox>
                        <!-- Output -->
                        <Title id="titleOutput" text="{i18n>Output}" level="H4" class="sapUiMediumMarginTop" />
                        <VBox id="outputVBox" class="sapUiSmallMarginTop" width="97%">
                           <Label id="lblTransferFormat" text="{i18n>TransForm}" class="sapUiSmallMarginTop sapUiTinyMarginBottom" />
                           <Select id = "transF" width="100%" class="sapUiSmallMarginBottom" selectedKey="{send>/transferFormat}" change=".onValueChange">
                              <items>
                                 <core:Item id="itemTransferPdf" key="pdf" text="PDF" />
                                 <core:Item id="itemTransferXrechnung" key="xrechnung" text="XRechnung" />
                                 <core:Item id="itemTransferZugferd" key="zugferd" text="ZUGFeRD" />
                                 <core:Item id="itemTransferPaper" key="paper" text="Paper" />
                              </items>
                           </Select>

                           <Label id="lblDeliveryMethod" text="{i18n>DelMeth}" class="sapUiSmallMarginTop sapUiTinyMarginBottom" />
                           <Select id = "delMeth" width="100%" class="sapUiSmallMarginBottom" selectedKey="{send>/deliveryMethod}" change=".onValueChange">
                              <items>
                                 <core:Item id="itemDeliveryEmail" key="email" text="Email" />
                                 <core:Item id="itemDeliveryPost" key="post" text="Postal Service" />
                                 <core:Item id="itemDeliveryGateway" key="eGateWay" text="EGatewayProvider" />
                              </items>
                           </Select>

                           <Input id="inpRecipient" placeholder="Receiver" class="sapUiSmallMarginBottom" value="{send>/recipient}" liveChange=".onValueChange"/>
                           <Input id="inpCc" placeholder="CC" class="sapUiSmallMarginBottom" value="{send>/cc}" liveChange=".onValueChange"/>
                           <Input id="inpBcc" placeholder="BCC" class="sapUiSmallMarginBottom" value="{send>/bcc}" liveChange=".onValueChange"/>
                        </VBox>
                        <!-- ================== Templates ================== -->
                        <Title id="titleTemplates" text="{i18n>Templates}" level="H4" class="sapUiMediumMarginTop" />

                        <VBox id="tplBox" class="sapUiSmallMarginTop">

                           <!-- Subject -->
                           <Label id="lblTemplateSubject" text="{i18n>Subject}" class="sapUiTinyMarginBottom" />
                           <FormattedText id="ftTemplateSubject" class="sapUiTinyMarginBottom" htmlText="{path:'template>subject', formatter: '.formatTemplateSubject'}" />

                           <!-- Body -->
                           <Label id="lblTemplateBody" text="{i18n>Body}" class="sapUiMediumMarginTop sapUiTinyMarginBottom" />
                           <FormattedText id="ftTemplateBody" class="sapUiSmallMarginBottom" htmlText="{path:'template>body', formatter: '.formatTemplateBody'}" />

                           <Button id="btnEditTemplate" text="{i18n>Edit}" type="Emphasized" class="sapUiTinyMarginTop" press=".onOpenTemplateDialog" />
                        </VBox>
                        <!-- ================================================= -->

                     </VBox>
                  </ScrollContainer>
               </IconTabFilter>
               <!-- ================== HISTORY TAB ================== -->
               <IconTabFilter id="historyFilt" key="history" text="History">
                  <ScrollContainer id="scOverview" height="100%" width="100%" horizontal="false" vertical="true">

                     <VBox id="historyOuterVBox" width="100%">

                        <List id="lstHistory" width="100%" class="historyListWhite" items="{history>/logs}" noDataText="No history entries." growing="true" growingScrollToLoad="true" showSeparators="Inner">

                           <CustomListItem id="cliHistoryItem">
                              <HBox id="hboxHistoryRow" class="histRow" width="100%">
                                 <!-- linke Spalte: Status -->
                                 <ObjectStatus id="objStatusHistory" class="histStatus" text="{history>statusText}" state="{history>statusState}" inverted="true" />

                                 <!-- rechte Spalte: Datum/Code + Message -->
                                 <VBox id="vboxHistoryText" class="histText" width="100%">
                                    <Text id="txtHistoryMeta" text="{parts: [{path:'history>date'}, {path:'history>code'}], formatter: '.formatHistoryMeta'}" wrapping="false" class="sapUiTinyMarginTop sapUiTinyMarginBottom sapUiTinyMarginBegin" />

                                    <Text id="txtHistoryMessage" text="{history>message}" wrapping="true" class="sapUiTinyMarginBottom sapUiTinyMarginBegin" />
                                 </VBox>
                              </HBox>
                           </CustomListItem>

                        </List>
                     </VBox>
                  </ScrollContainer>
               </IconTabFilter>

            </items>
         </IconTabBar>
      </content>
      <!-- Footer mit Save / Send -->
      <footer>
         <Toolbar id="footerToolbar">
            <ToolbarSpacer id="footerToolbarSpacer" />
            <Button id="btnSave" text="{i18n>Save}" type="Transparent" enabled="{docCache>/canSave}" press=".onPressSave"/>
            <Button id="btnSend" text="{i18n>Send}" type="Emphasized" enabled="{send>/canSend}" press=".onSendInvoice"/>
         </Toolbar>
      </footer>
   </Page>
</mvc:View>