<core:FragmentDefinition xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Dialog id="msgTemplateDialog" title="{i18n>PopupTemplateTitle}" contentWidth="700px" contentHeight="400px" resizable="true" draggable="true">

        <content>
            <HBox id="dlgHBox" width="100%">
                <!-- Linke Seite: Subject + Body -->
                <VBox id="dlgLeftVBox" width="100%" class="sapUiSmallMargin">
                    <Label id="lblSubject" text="{i18n>Subject}:"/>
                    <Input id="inpSubject" placeholder="{i18n>PlaceholderSubj}" value="{template>subject}" class="sapUiSmallMarginBottom" />

                    <Label id="lblBody" text="{i18n>Body}:"/>
                    <TextArea id="txtAreaBody" value="{template>body}" rows="10" width="100%" placeholder="{i18n>PlaceholderBody}" />
                </VBox>

                <!-- Rechte Seite: Sprachenliste -->
                <VBox id="dlgRightVBox" width="200px" class="sapUiSmallMarginEnd">
                    <List id="lstLanguages" mode="SingleSelect" selectionChange=".onLanguageSelectionChange" items="{
                            path: 'template>/languages'
                        }">
                        <StandardListItem id="LanguagesId" title="{path: 'template>textKey', formatter: '.formatI18n'}" type="Active" />
                    </List>
                </VBox>
            </HBox>
        </content>

        <beginButton>
            <Button id="btnCancelTemplate" text="{i18n>Cancel}" press=".onTemplateDialogCancel" />
        </beginButton>

        <endButton>
            <Button id="btnSaveTemplate" text="{i18n>Save}" type="Emphasized" press=".onTemplateDialogSave" />
        </endButton>

    </Dialog>

</core:FragmentDefinition>